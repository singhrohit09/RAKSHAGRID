# RakshaGrid Environment Configuration (Phase 2 Full-Stack)
# The application supports both zero-configuration embedded SQLite and production PostgreSQL.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"

# Authentication & Security
# Generate a cryptographically secure 256-bit secret outside source control using:
#   npm run generate-secret
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Administrator Provisioning
# In production, set a high-entropy secret (min 10 chars with mixed case, digits, symbols),
# or provision interactively via: npm run server:bootstrap-admin
INITIAL_ADMIN_PASSWORD=""

# External Data & Weather Provider Integrations (Phase 3)
# Primary: Open-Meteo Meteorological WMO Service (Free & Open - Requires No API Key)
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
FLOOD_API_URL="https://flood-api.open-meteo.com/v1/flood"

# Optional Commercial Weather Provider (Leave blank to use default Open-Meteo)
WEATHER_API_KEY=""

# Optional Webhook Alert Notification Endpoint (e.g. Slack / Civil Alert Relay)
ALERT_WEBHOOK_URL=""

# Phase 4: Multi-Agent AI System & Provider Architecture
# When AI_API_KEY is omitted, RakshaGrid automatically and safely runs the
# high-performance deterministic rule-based analytical intelligence engine.
AI_PROVIDER="gemini" # Options: "gemini" | "openai"
AI_API_KEY="" # Kept securely on backend only; never exposed in client bundles
AI_MODEL="gemini-1.5-flash" # Gemini: "gemini-1.5-flash" | OpenAI: "gpt-4o-mini"
AI_TIMEOUT_MS="10000"

# Database Configuration
# 1. Embedded SQLite (Default - requires no external database server):
SQLITE_PATH="server/data/rakshagrid.db"

# 2. PostgreSQL (Production):
# DATABASE_URL="postgresql://raksha_admin:secretpassword@localhost:5432/rakshagrid_prod?sslmode=require"

# Frontend Configuration (Vite)
VITE_APP_NAME="RakshaGrid"
VITE_APP_TAGLINE="Disaster Intelligence. Coordinated Response. Safer Communities."
VITE_APP_ENV="development"
VITE_APP_VERSION="2.0.0-phase2"
VITE_API_URL="/api"

# Map Configuration
VITE_MAP_DEFAULT_LAT="28.6139"
VITE_MAP_DEFAULT_LNG="77.2090"
VITE_MAP_DEFAULT_ZOOM="11"
VITE_MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
