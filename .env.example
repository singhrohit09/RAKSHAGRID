# RakshaGrid Environment Configuration (Phase 1 Prototype)
# Note: In Phase 1, all data is managed via local demo persistence.
# These environment variables configure client-side parameters and future service placeholders.

# Operational Deployment
VITE_APP_NAME="RakshaGrid"
VITE_APP_TAGLINE="Disaster Intelligence. Coordinated Response. Safer Communities."
VITE_APP_ENV="demo"
VITE_APP_VERSION="1.0.0-phase1"

# Map Configuration
VITE_MAP_DEFAULT_LAT="28.6139"
VITE_MAP_DEFAULT_LNG="77.2090"
VITE_MAP_DEFAULT_ZOOM="11"
VITE_MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# Future Integration Service Placeholders (Phase 2+)
# Real endpoints and keys should NEVER be committed.
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WEATHER_API_URL="https://api.example.gov/weather"
VITE_SEISMIC_FEED_URL="https://earthquake.example.gov/feed"
VITE_CAP_SERVER_URL="https://alerting.example.gov/cap"
