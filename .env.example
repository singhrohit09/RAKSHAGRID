# ==============================================================================
# RakshaGrid - Disaster Intelligence & Coordinated Response Environment Config
# ==============================================================================
# NOTE: This file contains configuration examples and documentation only.
# NEVER commit real API keys, credentials, service role tokens, or production database passwords.
# All client-accessible variables MUST start with the VITE_ prefix.

# Operational Environment mode (development | staging | production)
VITE_APP_ENV="development"

# Emergency Operations Center (EOC) Node Identifier
VITE_DISASTER_NODE_ID="IN-EOC-NODE-01"

# Default Command Region
VITE_DEFAULT_COMMAND_REGION="Eastern & Coastal Command Hub"

# Supabase Realtime Database & Auth (Optional - falls back seamlessly to in-memory local state if omitted)
# Public Project URL from Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Public Anon Key (Row Level Security protected)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CRITICAL SECURITY RULE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or database admin passwords in client-facing environments.

# Optional Real-Time Weather Integration (OpenWeather API v2.5 / v3.0)
# Falls back dynamically to offline mathematical hydrological models if omitted or rate-limited
VITE_OPENWEATHER_API_KEY=""

# Optional Gemini AI API Key for generative situational intelligence synthesis
# Automatically injected in AI Studio or configured in local backend proxy
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Application hosting URL (auto-injected in AI Studio Cloud Run)
APP_URL="https://rakshagrid.vercel.app"
